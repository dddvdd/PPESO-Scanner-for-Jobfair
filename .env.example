# Supabase public configuration (safe for the browser).
# Copy this file to .env and fill in values from your Supabase dashboard:
# Project Settings -> API
# NEVER put the service-role key or any secret in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# --- Playwright E2E (local only; do not commit real values) -----------------
# These belong in .env.local (gitignored). The auth smoke tests fail with a
# clear message when they are missing.
E2E_STAFF_EMAIL=
E2E_STAFF_PASSWORD=
